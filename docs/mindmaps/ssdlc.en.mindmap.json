    },
    {
      "id": "g4",
      "parent": "g",
      "text": "No deps",
      "color": null,
      "order": 3,
      "note": "standard library only, no network"
    },
    {
      "id": "h4",
      "parent": "h",
      "text": "Credential paths",
      "color": null,
      "order": 3,
      "note": "~/.ssh, ~/.aws, .env*, key files; globs too (ASI03, LLM02:2026)"
    },
    {
      "id": "s5",
      "parent": "s",
      "text": "AI review",
      "color": null,
      "order": 4,
      "note": "/ssdlc:ai-security-review — LLM01–10:2026, ASI01–10, MIT causal grid, coverage matrix"
    },
    {
      "id": "h5",
      "parent": "h",
      "text": "Resolve links",
      "color": null,
      "order": 4,
      "note": "$.fs.stat realPath blocks in-repo symlinks to credentials"
    },
    {
      "id": "g5",
      "parent": "g",
      "text": "Prompt carriers",
      "color": null,
      "order": 4,
      "note": "Unicode tag smuggling (decoded), zero-width / bidi (LLM01:2026)"
    },
    {
      "id": "g6",
      "parent": "g",
      "text": "Agent perms",
      "color": null,
      "order": 5,
      "note": "bypassPermissions, autoApprove, wildcard allow-lists, REPL tools (LLM03:2026, ASI02/05)"
    },
    {
      "id": "s6",
      "parent": "s",
      "text": "Review mode",
      "color": null,
      "order": 5,
      "note": "plain message ssdlc review-mode on|off|status (or /ssdlc-review-mode in a terminal): main session limited to exact command forms, no network, report-only writes, ssdlc reviewers only; only a person can switch it off"
    },
    {
      "id": "h6",
      "parent": "h",
      "text": "Tripwire",
      "color": null,
      "order": 5,
      "note": "credential read or forbidden tool = tripwire → alert on the main session's next tool result → BLOCK; see guard_log"
    },
    {
      "id": "g7",
      "parent": "g",
      "text": "MCP config",
      "color": null,
      "order": 6,
      "note": "unpinned versions, inline secrets, plaintext transport (ASI04/07)"
    },
    {
      "id": "s7",
      "parent": "s",
      "text": "Codify findings",
      "color": null,
      "order": 6,
      "note": "/ssdlc:rule-from-finding: confirmed finding → rule + planted defect + safe counterpart + tests (flywheel)"
    },
    {
      "id": "h7",
      "parent": "h",
      "text": "Allow-list",
      "color": null,
      "order": 6,
      "note": "v0.4.0: reviewers read only paths named in the dispatching prompt (else the working directory) + the plugin folder"
    },
    {
      "id": "g8",
      "parent": "g",
      "text": "Strict by default",
      "color": null,
      "order": 7,
      "note": "allow markers ignored by default (--honor-markers to apply; never hide secrets / invisible chars); skipped files listed, exit 3 = INCOMPLETE"
    },
    {
      "id": "h8",
      "parent": "h",
      "text": "Liveness check",
